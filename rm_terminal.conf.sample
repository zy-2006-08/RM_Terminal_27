# RM Terminal 配置文件（样例模板）。
#
# 真正在用的队内统一配置是仓库根目录的 rm_terminal.conf（已提交进仓库，全队共用）；
# 本文件不参与运行，是现场参考模板：所有键的完整说明和可选项都在这里。
#
# 用法：复制成 rm_terminal.conf，或者用下面两种方式显式指定：
#   build/debug/rm_terminal --config path/to/rm_terminal.conf
#   RM_TERMINAL_CONFIG=path/to/rm_terminal.conf build/debug/rm_terminal
#
# 查找优先级（从高到低）：
#   1. 命令行 --config <路径>
#   2. 环境变量 RM_TERMINAL_CONFIG
#   3. 当前目录下的 ./rm_terminal.conf
#   4. 下面这些内置默认值
#
# 文件不存在不算错误，程序直接用默认值跑。文件存在但写错（未知的键、空值、
# 非正整数、未知的日志等级）会大声失败：退出码 4。唯一的例外是
# blind_stale_fallback_ms，它也接受 0；见下面的说明。
#
# 语法：每行一个 key=value。空行和以 # 开头的行会被忽略。
# 键和值两边的空白会被去掉。

# MQTT broker 地址。127.0.0.1 是本地模拟器；比赛网络里官方服务器是
# 192.168.12.1（2027 协议）。
mqtt_host=127.0.0.1

# MQTT broker 端口。2027 协议用 3333。
mqtt_port=3333

# H.265 图传的 UDP 监听端口。2027 协议用 3334。
udp_port=3334

# 本机图传用什么解码：none = 软件解码（默认），vaapi = Intel 核显硬解
#（走 /dev/dri/renderD128，当前用户必须在 render 组里），auto = 有可用 render
# 设备就用硬解，没有或硬解失败自动退回软解。
#video_hwaccel=auto

# 席位（2027 选手端）：红方 1 重装、3/4 步兵、6 指挥手；蓝方 +100。
# 一般不用写：不写的话每次启动都会弹选席位页。
# 命令行 --seat <id> 和环境变量 RM_SELF_ID 的优先级比这一行高。
# 席位同时是官方服务器期望的 MQTT 客户端 ID。
#self_robot_id=3

# 字段新鲜度窗口（毫秒）：超过这个时间的字段会被标成「过期」。
# 必须大于最慢字段的两个发布周期：RobotPosition 是 1Hz，所以小于等于 1000
# 会导致位置数据刚收到就被判过期。
stale_window_ms=2200

# 写进日志的最低等级：debug、info、warning、error。
log_level=info

# 日志文件路径。程序重启会继续往后追加。
log_destination=rm_terminal.log

# 致盲数据连续「干净」多久之后，界面才允许退出视频模式。
# 防止短暂的干净采样让界面来回闪回地图。
mode_exit_hysteresis_ms=3000

# 事件历史条数上限。满了就丢弃最旧的记录，避免长时间比赛导致无限增长。
event_history_capacity=50

# 只有致盲数据过期时，等多久才强制回退到视频模式。
# 0 = 完全关闭这个回退：界面不会仅仅因为致盲数据过期就切到视频，
# 只有明确收到「致盲」信号才切。这是唯一接受 0 的整型键；-1 仍然非法。
blind_stale_fallback_ms=15000

# 地图标记在地图上保留多久（毫秒，最后 5 秒淡出）。
map_mark_ms=30000

# 是否在官方 1080p 显示器上全屏（重装和指挥手席位）。display_screen 是
# 启动日志里列出的 QScreen 名字（event=screens）；空 = 主屏。
display_fullscreen=false
#display_screen=HDMI-1

# 指挥手图传墙。指挥手自己没有图传；每台地面席位（1/3/4）把收到的每一个
# 图传 UDP 包原样转发到 video_relay_host，也就是指挥手终端在组网网口上的
# IPv4 地址（规则 3.3.1 允许操作间里的自定义终端有线互连）。不填 = 不转发。
# 指挥手按 video_wall_port + 车号监听（1 重装，3、4 步兵）；地面席位也按
# 同一个端口发，所以全队写同一个值。
#video_relay_host=10.27.0.6
video_wall_port=3340

# 自定义控制器（小机械臂）的串口。没有控制器的席位不要填，状态灯会显示
#「未启用」。"auto" 会逐个短暂打开 USB 串口，保留那个会发控制器帧（0x0302）
# 的端口，这样换 USB 串口线不用改配置；在识别出端口之前不会往任何端口写数据。
# 也可以写固定路径：优先用 /dev/serial/by-id/... 而不是 /dev/ttyUSB0，因为
# 重新插拔后编号可能变。Linux 下当前用户必须在 dialout 组里。
# run.sh 会把它指向模拟器的假机械臂。
#controller_serial=auto
#controller_serial=/dev/serial/by-id/usb-FTDI_FT232R_USB_UART-if00-port0

# 控制器波特率：9600、19200、38400、57600、115200、230400、460800 或 921600。
# 控制器固件（UART4）用 115200。
controller_baud=115200

# MQTT 保活时间（秒）。网线被拔掉后，大约要两个保活周期才能发现；
# 裁判灯则是不管怎样，2 秒没数据就变红。
mqtt_keepalive_s=5

# 控制度落后多少分触发一次提醒。
alert_control_gap=30

# Linux 离线语音的安装目录（scripts/setup_voice.sh）。默认：
#speech_dir=/home/you/.local/share/rm_terminal/tts
